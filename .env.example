# Скопируй в .env и подставь свои значения.
# Всё с префиксом VITE_ попадает в браузер — секретов здесь быть не должно.

VITE_SUPABASE_URL=https://<проект>.supabase.co
VITE_SUPABASE_ANON_KEY=<публичный anon-ключ проекта>

# Бот и короткое имя мини-приложения — из них собирается ссылка приглашения.
VITE_TG_BOT=MintlyAppbot
VITE_TG_APP=Mintly

# Серверные переменные (Vercel → Project Settings → Environment Variables),
# в этот файл их класть нельзя:
#   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET,
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET
